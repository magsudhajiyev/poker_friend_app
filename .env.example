# RevenueCat API Configuration
# Copy this file to .env and fill in your actual API key
# Get your API key from: https://app.revenuecat.com/ → Settings → API Keys

# RevenueCat Public SDK Key (works for all platforms: iOS, Android, Web)
REVENUECAT_API_KEY=your_api_key_here

# Debug Mode (for local testing without actual purchases)
# Set to 'true' to enable debug mode that simulates subscription states
# Set to 'false' or remove for production
DEBUG_SUBSCRIPTION_MODE=false

# Debug Subscription State (only used when DEBUG_SUBSCRIPTION_MODE=true)
# Options: 'free', 'monthly', 'annual', 'lifetime'
DEBUG_SUBSCRIPTION_STATE=free

# Firebase Configuration (optional - if needed in future)
# FIREBASE_API_KEY=your_firebase_api_key_here
