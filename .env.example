# Poker Logger Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# ==================== API Keys ====================

# Soniox API Key for speech-to-text
# Get your key from: https://soniox.com/
SONIOX_API_KEY=your_soniox_api_key_here

# RevenueCat API Key for subscriptions
# Get your key from: https://app.revenuecat.com/ -> Settings -> API Keys
REVENUECAT_API_KEY=your_revenuecat_api_key_here

# Resend API Key for email sending (dealer invitations)
# Get your key from: https://resend.com/ (free: 100 emails/day)
RESEND_API_KEY=your_resend_api_key_here

# ==================== Server URLs ====================

# WebSocket server URL for real-time communication
# Development: Use your machine's local IP (e.g., http://192.168.1.100:8000)
# Production: Use your deployed server URL
WEBSOCKET_SERVER_URL=http://192.168.100.6:8000

# API server URL for REST endpoints
API_SERVER_URL=http://192.168.100.6:8000

# ==================== Environment ====================

# Environment: development, staging, production
ENVIRONMENT=development

# ==================== Debug Settings ====================

# Enable debug mode for subscriptions (simulates states without actual purchases)
# Set to 'true' for local testing, 'false' for production
DEBUG_SUBSCRIPTION_MODE=false

# Debug subscription state (only used when DEBUG_SUBSCRIPTION_MODE=true)
# Options: free, monthly, annual, lifetime
DEBUG_SUBSCRIPTION_STATE=free

# ==================== Feature Flags ====================

# Enable voice recognition feature
ENABLE_VOICE_RECOGNITION=true

# Enable dealer mode feature
ENABLE_DEALER_MODE=true
