rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // FCM tokens - users can only manage their own tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // User notifications - users can only read/update their own notifications
    match /user_notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Users collection - anyone can read (for display names), only owner can write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // User stats - only owner can read/write
    match /user_stats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Poker sessions - only owner can read/write
    match /poker_sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Hands subcollection inherits session access
      match /poker_hands/{handId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Session results - only owner can read/write
    match /session_results/{resultId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Opponents - only owner can read/write
    match /opponents/{opponentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Opponent stats - authenticated users (linked to opponents via app logic)
    match /opponent_stats/{opponentId} {
      allow read, write: if isAuthenticated();
    }

    // Dealers collection
    match /dealers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Dealer sessions - participants can read, creator can write
    match /dealer_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.dealerId == request.auth.uid;

      match /hands/{handId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Seat assignments - authenticated read, owner write
    match /seat_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.playerId == request.auth.uid || resource.data.dealerId == request.auth.uid);
    }

    // Clubs - readable by all authenticated, writable by members
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Club members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() &&
          (memberId == request.auth.uid ||
           get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
      }

      // Club tables
      match /tables/{tableId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Club events
      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();

        match /final_standings/{standingId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }

      // Club notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // Shared hands - public read for web viewer, authenticated create
    match /shared_hands/{shareId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
