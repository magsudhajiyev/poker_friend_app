rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to check if user is the super admin
    function isSuperAdmin() {
      // email_verified guard (audit B10): without it, registering an
      // unverified account with this email would grant full admin.
      return request.auth != null &&
        request.auth.token.email == 'magsud94@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // FCM tokens - users can only manage their own tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // User notifications - users can read/update/delete their own.
    // Create stays open to authenticated users (club invitations create
    // docs FOR the invitee) but content is size/type-capped (audit B6
    // partial mitigation — full fix is moving sends server-side).
    match /user_notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId is string &&
        (!('title' in request.resource.data) ||
          (request.resource.data.title is string && request.resource.data.title.size() <= 200)) &&
        (!('body' in request.resource.data) ||
          (request.resource.data.body is string && request.resource.data.body.size() <= 500));
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Partner grants - owner can read their own, super admin has full access
    match /partner_grants/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Users collection - authenticated read (audit B8: was public — email
    // scraping), owner or superAdmin write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    // User stats - owner or superAdmin can read, only owner can write
    match /user_stats/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId);
    }

    // Poker sessions - owner/participants can read, superAdmin can read all
    match /poker_sessions/{sessionId} {
      allow read: if isSuperAdmin() || (isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds)));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Hands subcollection inherits session access (audit B7: was open to
      // any authenticated user — others' hole cards readable/tamperable).
      // Owner logs hands; live-session participants only read.
      match /poker_hands/{handId} {
        function sessionData() {
          return get(/databases/$(database)/documents/poker_sessions/$(sessionId)).data;
        }
        allow read: if isSuperAdmin() || (isAuthenticated() &&
          (sessionData().userId == request.auth.uid ||
           (sessionData().participantIds != null &&
            request.auth.uid in sessionData().participantIds)));
        allow write: if isAuthenticated() &&
          sessionData().userId == request.auth.uid;
      }
    }

    // Session results - owner or superAdmin can read, only owner can write
    match /session_results/{resultId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Opponents - owner or superAdmin can read, only owner can write
    match /opponents/{opponentId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Opponent stats - owner of the opponent profile only (audit B7: was
    // open to any authenticated user). Stats docs are only ever written for
    // saved opponents, whose profile doc exists first.
    match /opponent_stats/{opponentId} {
      allow read, write: if isSuperAdmin() || (isAuthenticated() &&
        get(/databases/$(database)/documents/opponents/$(opponentId)).data.userId == request.auth.uid);
    }

    // Dealers collection. Super admin writes others' docs during club-request
    // approval (_addClubToDealer runs as the approving admin, not the owner).
    match /dealers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    // Dealer sessions - participants can read, creator can write
    match /dealer_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.dealerId == request.auth.uid;

      match /hands/{handId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Seat assignments - authenticated read, owner write
    match /seat_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.playerId == request.auth.uid || resource.data.dealerId == request.auth.uid);
    }

    // Clubs - readable by all authenticated, writable by owner. Super admin
    // updates during club-request approval (club is created with the
    // REQUESTER as ownerId, then the approving admin sets address/phone/QR).
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid);

      // Club members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() &&
          (memberId == request.auth.uid ||
           get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
      }

      // Club tables
      match /tables/{tableId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Club events
      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();

        match /final_standings/{standingId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }

      // Club notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // Shared hands - public read for web viewer, authenticated create, admin delete
    match /shared_hands/{shareId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── Public + Admin collections (web landing page & dashboard, no Firebase Auth) ──

    // Usernames index - public read (web availability check), app writes via auth
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Nickname claims - public read/create (web reservation), admin full access
    match /nickname_claims/{claimId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Waitlist - public read/create (landing page signup), admin full access
    match /waitlist/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Contact form submissions - public create (contact form), admin read/manage
    match /contact_submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // App config (feature flags) - everyone reads, only super admin writes
    match /app_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Email templates - admin dashboard only
    match /email_templates/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Email logs - admin dashboard only
    match /email_logs/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Inbox replies - admin dashboard only
    match /inbox_replies/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Inbox status (read/archive/delete state) - admin dashboard only
    match /inbox_status/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // App admins registry - authenticated users read (to check their own admin
    // status via isAppAdmin()); only super admin provisions/removes admins.
    match /app_admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Club registration requests - user submits their own, super admin reviews.
    match /club_requests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.requestedBy == request.auth.uid;
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.requestedBy == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    // Support requests - user submits, super admin reads/manages in dashboard.
    match /support_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }
  }
}
