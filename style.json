{
    "designSystem": {
      "colors": {
        "background": {
          "primary": "#1a1a1e",
          "secondary": "#2d2d30",
          "gradient": "linear-gradient(135deg, #2d2d30 0%, #1a1a1e 100%)"
        },
        "text": {
          "primary": "#ffffff",
          "secondary": "#8e8e93",
          "tertiary": "rgba(255, 255, 255, 0.8)"
        },
        "accent": {
          "blue": "#007aff",
          "green": "#30d158",
          "red": "#ff3b30",
          "purple": "#667eea",
          "orange": "#feca57"
        },
        "glass": {
          "background": "rgba(255, 255, 255, 0.05)",
          "border": "rgba(255, 255, 255, 0.1)",
          "highlight": "rgba(255, 255, 255, 0.2)"
        }
      },
      "typography": {
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "sizes": {
          "title": {
            "fontSize": "28px",
            "fontWeight": "700",
            "lineHeight": "1.2"
          },
          "subtitle": {
            "fontSize": "18px",
            "fontWeight": "600",
            "lineHeight": "1.3"
          },
          "body": {
            "fontSize": "16px",
            "fontWeight": "600",
            "lineHeight": "1.4"
          },
          "caption": {
            "fontSize": "14px",
            "fontWeight": "400",
            "lineHeight": "1.4"
          },
          "small": {
            "fontSize": "12px",
            "fontWeight": "400",
            "lineHeight": "1.3"
          },
          "large": {
            "fontSize": "32px",
            "fontWeight": "700",
            "lineHeight": "1.1"
          }
        }
      },
      "spacing": {
        "xs": "4px",
        "sm": "8px",
        "md": "12px",
        "lg": "16px",
        "xl": "20px",
        "xxl": "24px",
        "xxxl": "32px"
      },
      "borderRadius": {
        "sm": "8px",
        "md": "12px",
        "lg": "16px",
        "xl": "20px",
        "xxl": "24px",
        "full": "50%"
      }
    },
    "components": {
      "card": {
        "base": {
          "background": "rgba(255, 255, 255, 0.05)",
          "backdropFilter": "blur(10px)",
          "borderRadius": "20px",
          "border": "1px solid rgba(255, 255, 255, 0.1)",
          "padding": "20px",
          "marginBottom": "16px"
        },
        "hero": {
          "background": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
          "height": "180px",
          "color": "#ffffff"
        },
        "wallet": {
          "background": "linear-gradient(135deg, rgba(116, 235, 213, 0.2), rgba(159, 172, 230, 0.2))",
          "backdropFilter": "blur(20px)",
          "border": "1px solid rgba(255, 255, 255, 0.2)",
          "height": "200px"
        }
      },
      "button": {
        "primary": {
          "background": "#007aff",
          "padding": "8px 16px",
          "borderRadius": "8px",
          "color": "#ffffff",
          "fontSize": "12px",
          "fontWeight": "600"
        },
        "glass": {
          "background": "rgba(255, 255, 255, 0.2)",
          "backdropFilter": "blur(10px)",
          "padding": "12px 20px",
          "borderRadius": "12px",
          "color": "#ffffff",
          "fontWeight": "600"
        }
      },
      "avatar": {
        "size": "44px",
        "borderRadius": "50%",
        "background": "linear-gradient(135deg, #ff6b6b, #feca57)",
        "fontSize": "16px",
        "fontWeight": "600"
      },
      "transaction": {
        "icon": {
          "size": "40px",
          "borderRadius": "12px",
          "background": "rgba(255, 255, 255, 0.1)"
        },
        "item": {
          "padding": "16px 0",
          "borderBottom": "1px solid rgba(255, 255, 255, 0.05)"
        }
      },
      "statsCard": {
        "background": "rgba(255, 255, 255, 0.05)",
        "backdropFilter": "blur(10px)",
        "borderRadius": "16px",
        "padding": "16px",
        "border": "1px solid rgba(255, 255, 255, 0.1)"
      },
      "bottomNav": {
        "background": "rgba(255, 255, 255, 0.1)",
        "backdropFilter": "blur(20px)",
        "borderRadius": "24px",
        "padding": "12px 24px",
        "border": "1px solid rgba(255, 255, 255, 0.1)",
        "gap": "24px"
      }
    },
    "effects": {
      "glassmorphism": {
        "background": "rgba(255, 255, 255, 0.05)",
        "backdropFilter": "blur(10px)",
        "border": "1px solid rgba(255, 255, 255, 0.1)"
      },
      "heavyGlass": {
        "background": "rgba(255, 255, 255, 0.1)",
        "backdropFilter": "blur(20px)",
        "border": "1px solid rgba(255, 255, 255, 0.2)"
      },
      "highlight": {
        "background": "linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent)",
        "height": "1px",
        "position": "top"
      },
      "hover": {
        "transform": "translateY(-2px)",
        "borderColor": "rgba(255, 255, 255, 0.2)",
        "transition": "all 0.3s ease"
      },
      "shadows": {
        "card": "0 4px 12px rgba(0, 0, 0, 0.15)",
        "button": "0 2px 8px rgba(0, 122, 255, 0.3)",
        "3d": "0 4px 12px rgba(102, 126, 234, 0.3)"
      }
    },
    "layout": {
      "container": {
        "maxWidth": "375px",
        "padding": "24px",
        "borderRadius": "24px"
      },
      "grid": {
        "stats": {
          "columns": "1fr 1fr",
          "gap": "16px"
        }
      },
      "header": {
        "display": "flex",
        "justifyContent": "space-between",
        "alignItems": "center",
        "marginBottom": "32px"
      }
    },
    "animations": {
      "hover": {
        "duration": "0.3s",
        "easing": "ease",
        "transform": "translateY(-1px)"
      },
      "3dIcon": {
        "transform": "perspective(100px) rotateX(10deg)"
      }
    },
    "adaptations": {
      "forPokerApp": {
        "colors": {
          "brand": "#C85A54",
          "table": "#1B3B36",
          "chips": "#F39C12",
          "cards": "#FAFBFC"
        },
        "iconStyle": "3D rendered poker elements",
        "cardTypes": ["chip stack", "table view", "hand history", "tournament bracket"]
      }
    }
  }